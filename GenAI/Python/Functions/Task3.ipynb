    "# lambda function:\n",
    "gst = lambda price: price + (0.18*price)\n",
    "print(gst(100))\n",
    "final_price = lambda price, discount: gst(price - (price * discount / 100))\n",
    "print(final_price(1000, 10))  "
   ]
